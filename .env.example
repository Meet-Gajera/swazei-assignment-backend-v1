# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# CHANGE THIS in any non-local environment.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Option A - external PostgreSQL (recommended for production / CI):
#   DATABASE_URL=postgres://user:password@localhost:5432/swazei_pos
#
# Option B - no DATABASE_URL: the application boots a real PostgreSQL server
#   from the binaries bundled with the `embedded-postgres` dev dependency.
#   This makes the project runnable WITHOUT Docker or a system PostgreSQL.
#   Set USE_EMBEDDED_DB=false to disable the fallback.
#   The cluster is stored in .pgdata/ (git-ignored) and survives restarts.
# DATABASE_URL=
USE_EMBEDDED_DB=true
EMBEDDED_DB_PORT=55432
# Load the sample data (merchants/stores/users/products) on boot.
# Defaults to true for the embedded database and false for an external one.
SEED_ON_START=true
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=swazei_pos
DB_SSL=false
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

# ---------------------------------------------------------------------------
# Redis (optional)
# ---------------------------------------------------------------------------
# Redis powers the product/inventory cache and the async event queue.
# When it is not reachable the app transparently falls back to an in-process
# cache / queue so it still runs standalone.
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false
CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Payments (mock provider)
# ---------------------------------------------------------------------------
# Probability (0..1) that the mock provider approves a payment when the
# request does not explicitly force an outcome.
PAYMENT_DEFAULT_SUCCESS_RATE=1.0

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
